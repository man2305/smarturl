# ============ Server ============
NODE_ENV=production
PORT=5000

# Public origin of the API — used to build short URLs.
# Set to your Render service URL, e.g. https://smarturl-api.onrender.com
BASE_URL=https://smarturl-api.onrender.com

# ============ Database ============
# MongoDB Atlas M0 free cluster connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smarturl

# ============ Redis ============
# Upstash Redis (TLS). Set to rediss://... Leave empty to run DB-only.
REDIS_URL=rediss://<token>@<upstash-endpoint>:6379
# TTL (seconds) for cached short-link payloads
CACHE_TTL=86400

# ============ Auth / JWT ============
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=smarturl
JWT_AUDIENCE=smarturl-api

# ============ CORS ============
# Origin of the Vercel frontend.
CLIENT_URL=https://smarturl-frontend.vercel.app

# ============ Rate limiting (optional overrides) ============
# RATE_LIMIT_MAX=100
