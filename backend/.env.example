# ============ Server ============
NODE_ENV=development
PORT=5000

# Public base URL of this API (used to build short URLs)
BASE_URL=http://localhost:5000

# ============ Database ============
# MongoDB connection string (MongoDB Atlas recommended in production)
MONGODB_URI=mongodb://127.0.0.1:27017/smarturl

# ============ Redis ============
# Upstash Redis or local Redis. Leave empty to run without caching.
REDIS_URL=redis://localhost:6379
# TTL (seconds) for cached short-link payloads
CACHE_TTL=86400

# ============ Auth / JWT ============
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=smarturl
JWT_AUDIENCE=smarturl-api

# ============ CORS ============
CLIENT_URL=http://localhost:5173

# ============ Rate limiting (optional overrides) ============
# Caps are requests per window per key (IP, or user for link creation).
# Windows are fixed: 1 min for api/shorten/redirect, 15 min for auth/refresh.
# RATE_LIMIT_MAX=100
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_SHORTEN_MAX=30
# RATE_LIMIT_REDIRECT_MAX=120
# RATE_LIMIT_REFRESH_MAX=60
